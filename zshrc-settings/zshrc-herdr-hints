#                                                                                       HERDR HINTS
# ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
# Type `herdrhint` (or `herderhint`) for a herdr command + keybinding cheat sheet.
#
# Install: paste this whole file into ~/.zshrc, then `source ~/.zshrc`.
#          Or save it somewhere and add:  source /path/to/zshrc-herdr-hints
#
# The keybindings below match the [keys] block in ~/.config/herdr/config.toml.
# If you rebound anything in your own config, edit the matching lines here.
# Config reference: https://herdr.dev/docs/config-reference/
#
# Optional startup reminder — uncomment to print it on every new shell:
# echo "'herdrhint' ► herdr hints"

function herdrhint() {
    command cat << 'EOF'
⎼⎼ 🔑 GENERAL  (prefix = ⌃B) ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  prefix g          → goto
•  prefix ⇧R         → reload config
•  prefix s          → settings
•  prefix o          → open notification target
•  prefix b          → toggle sidebar

⎼⎼ 🪟 WORKSPACES (SPACES) ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  prefix ⇧N         → new workspace
•  prefix ⇧D         → close workspace
•  prefix w          → workspace picker (then ↑ / ↓ or number)
•  prefix ⇧W         → rename workspace
•  prefix ⇧1..9      → switch workspace

⎼⎼ 🤖 AGENTS ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  prefix a          → next agent
•  prefix q          → previous agent

⎼⎼ 🗂️ TABS ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  prefix c          → new tab
•  prefix ⇧T         → rename tab
•  prefix n          → next tab
•  prefix p          → previous tab
•  prefix 1..9       → switch tab
•  prefix ⇧X         → close tab

⎼⎼ 🔲 PANES ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  prefix \ or v     → split vertical
•  prefix -          → split horizontal
•  prefix x          → close pane
•  prefix z          → zoom pane
•  prefix ⇧P         → rename pane
•  prefix r          → resize mode
•  prefix h j k l    → focus pane left / down / up / right

⎼⎼ 🐑 HERDR COMMANDS ⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
•  herdr server stop                          → stop herdr
•  herdr machine add <ssh_entry> --label <s>  → add ssh remote
•  herdr machine list                         → list ssh remotes
•  herdr machine remove <id>                  → remove ssh remote
•  herdr machine disable <id>                 → disable ssh remote
⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼⎼
EOF
}
