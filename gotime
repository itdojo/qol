#!/usr/bin/env bash
# ----------------------------------------------------------------------------
# gotime
#
# Pick a workspace from a colorful menu of your work trees, then spin up a tmux
# session wired for a work session:
#
#   pinned window   an always-present directory (optional) -> starts $GOTIME_CMD
#   "<selection>"   the workspace you chose                -> starts $GOTIME_CMD
#   "local"         ~                                      -> just a shell prompt
#
# Which trees it scans, and whether there is a pinned window at all, come from
# config rather than from this file. With no config it scans whichever of
# ~/projects, ~/code, ~/src, ~/dev, ~/work, and ~/repos exist, and opens no
# pinned window. `gotime --init` writes a starter config to edit.
#
# Navigate the menu with the arrow keys (or j/k), jump by typing an item's
# number, press Enter to launch, q/Esc to cancel.
#
# Usage:
#   gotime                 # show the menu, then launch
#   gotime <slug>          # skip the menu, launch straight for <slug>
#   gotime --list          # show the resolved config and what it can see
#   gotime --init          # write a starter config file
#   gotime -h | --help     # this help
#
# Config file — $XDG_CONFIG_HOME/gotime/config (default ~/.config/gotime/config),
# falling back to ~/.gotimerc. It is sourced as bash, so $HOME and command
# substitution work:
#
#   GOTIME_ROOTS   # trees to scan. "[LABEL:]path" entries separated by
#                  # whitespace or newlines; without a LABEL the directory's
#                  # own name becomes the menu heading. Paths must not contain
#                  # spaces.
#   GOTIME_PIN     # "[LABEL:]path" for the always-present first window.
#                  # Empty (the default) means no pinned window.
#   GOTIME_SESSION # tmux session name (default: gotime)
#   GOTIME_CMD     # command started in the pinned and selected windows
#                  # (default: claude). The "local" window never runs it.
#
# Every config key is also an environment variable, and the environment wins.
#
# Other knobs:
#   GOTIME_CONFIG=path     # read this config file instead of the default
#   GOTIME_NO_ATTACH=1     # build the session but do not attach (used by tests)
#   NO_COLOR=1             # disable color
#
# Only depends on bash, tmux, and tput. Written to run on both modern bash and
# macOS's stock bash 3.2.
# ----------------------------------------------------------------------------

set -o pipefail

# --- configuration ----------------------------------------------------------
# Where to look when GOTIME_ROOTS says nothing: the conventional names for a
# tree of checkouts. Every one that exists is scanned, not just the first —
# people who keep both ~/work and ~/src want both.
GOTIME_DEFAULT_ROOTS='projects code src dev work repos'

GOTIME_CONFIG_LOADED=""   # the config file actually read, or "" for none
PIN_LABEL=""              # tmux window name for the pinned window, "" = no pin
PIN_PATH=""               # its directory

# Parallel arrays describing every selectable item (bash 3.2 has no assoc arrays).
NAMES=()   # slug / display name
PATHS=()   # absolute path
KINDS=()   # the root's label, uppercased — the menu section it sits under
COUNT=0

SELIDX=0        # menu result: index of chosen item, or -1 if cancelled
TUI_ACTIVE=""   # set while the alternate screen / hidden cursor is in effect
KEY=""          # last decoded key (set by read_key)
KEYCH=""        # the literal char for a DIGIT key

# --- colors -----------------------------------------------------------------
# IT Dojo terminal design system. Palette and rules:
#   ~/vaults/dojobrain/30-references/design-system/itdojo-terminal-design-system.md
# Truecolor by default; QOL_COLOR_DEPTH=256|8|none forces down. Detection is
# not attempted — SSH strips COLORTERM, so it would always guess low.
# C_STEEL (the INFO ink) has no reader: gotime states and asks, it never
# narrates, so it emits no INFO-level line. It is carried anyway so this copy
# of the palette stays a complete copy of the token set.
# shellcheck disable=SC2034
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    case "${QOL_COLOR_DEPTH:-truecolor}" in
        256)
            C_JADE=$'\033[38;5;77m'
            C_VIOLET=$'\033[38;5;140m'
            C_STEEL=$'\033[38;5;110m'
            C_SAFFRON=$'\033[38;5;179m'
            C_STOP=$'\033[38;5;168m'
            C_FG=$'\033[38;5;189m'
            C_META=$'\033[38;5;103m'
            C_RULE=$'\033[38;5;60m'
            SEL_BG=$'\033[48;5;235m'
            ;;
        8)
            C_JADE=$'\033[92m'
            C_VIOLET=$'\033[94m'
            C_STEEL=$'\033[94m'
            C_SAFFRON=$'\033[93m'
            C_STOP=$'\033[91m'
            C_FG=$'\033[97m'
            C_META=$'\033[90m'
            C_RULE=$'\033[90m'
            SEL_BG=$'\033[7m'
            ;;
        none)
            C_JADE="" C_VIOLET="" C_STEEL="" C_SAFFRON="" C_STOP=""
            C_FG="" C_META="" C_RULE="" SEL_BG=""
            ;;
        *)
            C_JADE=$'\033[38;2;78;206;106m'
            C_VIOLET=$'\033[38;2;188;176;232m'
            C_STEEL=$'\033[38;2;122;160;216m'
            C_SAFFRON=$'\033[38;2;224;180;90m'
            C_STOP=$'\033[38;2;224;107;130m'
            C_FG=$'\033[38;2;228;222;245m'
            C_META=$'\033[38;2;154;147;181m'
            C_RULE=$'\033[38;2;74;65;112m'
            SEL_BG=$'\033[48;2;36;29;61m'
            ;;
    esac
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
else
    C_RESET="" C_BOLD="" C_FG="" C_JADE="" C_VIOLET="" C_STEEL=""
    C_SAFFRON="" C_STOP="" C_META="" C_RULE="" SEL_BG=""
fi

# Cursor control is not color, so it is gated on the terminal alone: the
# redraw still has to erase what it overwrites when NO_COLOR is set.
if [[ -t 1 ]]; then
    CUR_HOME=$'\033[H'    # cursor to row 1, col 1
    CLR_EOL=$'\033[K'     # erase from cursor to end of line
    CLR_EOS=$'\033[J'     # erase from cursor to end of screen
else
    CUR_HOME="" CLR_EOL="" CLR_EOS=""
fi

# --- config -----------------------------------------------------------------
upper() { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }

xdg_config() { printf '%s/gotime/config' "${XDG_CONFIG_HOME:-$HOME/.config}"; }

# The config file gotime would read — which is also the path --init writes when
# nothing exists yet, so this returns the XDG path even when no file is there.
config_path() {
    if [[ -n "${GOTIME_CONFIG:-}" ]]; then printf '%s' "$GOTIME_CONFIG"; return; fi
    local xdg; xdg="$(xdg_config)"
    if   [[ -f "$xdg" ]];            then printf '%s' "$xdg"
    elif [[ -f "$HOME/.gotimerc" ]]; then printf '%s' "$HOME/.gotimerc"
    else                                  printf '%s' "$xdg"
    fi
}

# Precedence is environment > config file > built-in default. The file is
# sourced rather than parsed so a path can be written as "$HOME/x", which means
# it can clobber a variable the environment already set — hence saving the
# environment's values first and putting them back afterwards.
load_config() {
    local env_roots="${GOTIME_ROOTS:-}"     env_pin="${GOTIME_PIN:-}"
    local env_session="${GOTIME_SESSION:-}" env_cmd="${GOTIME_CMD:-}"
    local f; f="$(config_path)"

    if [[ -f "$f" ]]; then
        # shellcheck disable=SC1090
        . "$f" || { printf 'gotime: could not read config %s\n' "$f" >&2; exit 1; }
        GOTIME_CONFIG_LOADED="$f"
    fi

    [[ -n "$env_roots"   ]] && GOTIME_ROOTS="$env_roots"
    [[ -n "$env_pin"     ]] && GOTIME_PIN="$env_pin"
    [[ -n "$env_session" ]] && GOTIME_SESSION="$env_session"
    [[ -n "$env_cmd"     ]] && GOTIME_CMD="$env_cmd"

    GOTIME_SESSION="${GOTIME_SESSION:-gotime}"
    GOTIME_CMD="${GOTIME_CMD:-claude}"
    GOTIME_PIN="${GOTIME_PIN:-}"
    GOTIME_ROOTS="${GOTIME_ROOTS:-$(default_roots)}"

    if [[ -n "$GOTIME_PIN" ]]; then
        PIN_LABEL="$(entry_label "$GOTIME_PIN")"
        PIN_PATH="$(entry_path "$GOTIME_PIN")"
    fi
}

default_roots() {  # whichever of the conventional work trees actually exist
    local d out=""
    for d in $GOTIME_DEFAULT_ROOTS; do
        [[ -d "$HOME/$d" ]] && out="${out}${out:+ }$HOME/$d"
    done
    printf '%s' "$out"
}

# An entry is "[LABEL:]path". Without a LABEL the directory's own name is used,
# so a bare "$HOME/projects" heads its section PROJECTS with no config at all.
entry_label() {
    local e="$1"
    if [[ "$e" == *:* ]]; then printf '%s' "${e%%:*}"; return; fi
    e="${e%/}"; printf '%s' "${e##*/}"
}

entry_path() {
    local e="$1"
    [[ "$e" == *:* ]] && e="${e#*:}"
    printf '%s' "${e%/}"
}

roots_oneline() { printf '%s' "$GOTIME_ROOTS" | tr '\n' ' '; }

# --- discovery --------------------------------------------------------------
add_items() {  # add_items <dir> <section-label>
    local dir="$1" kind="$2" p base
    [[ -d "$dir" ]] || return 0
    shopt -s nullglob
    for p in "$dir"/*/; do
        p="${p%/}"
        [[ -d "$p" ]] || continue
        base="${p##*/}"
        NAMES+=("$base"); PATHS+=("$p"); KINDS+=("$kind")
    done
    shopt -u nullglob
}

discover() {
    local e
    # Deliberate word splitting: GOTIME_ROOTS is a list, separated by either
    # whitespace or newlines, which is why paths in it may not contain spaces.
    # shellcheck disable=SC2086
    for e in $GOTIME_ROOTS; do
        # Uppercase the section label once here rather than per frame — draw()
        # runs on every keypress and `upper` forks.
        add_items "$(entry_path "$e")" "$(upper "$(entry_label "$e")")"
    done
    COUNT="${#NAMES[@]}"
}

# First match wins, so two roots holding a same-named directory resolve to
# whichever root is listed first. Use the menu when that matters.
find_slug() {  # echo the index of the item whose slug == $1, else nothing
    local want="$1" i
    for (( i = 0; i < COUNT; i++ )); do
        if [[ "${NAMES[$i]}" == "$want" ]]; then printf '%s' "$i"; return 0; fi
    done
    return 1
}

# --- drawing ----------------------------------------------------------------
# Ask the terminal, not terminfo. `tput cols 2>/dev/null` inside a command
# substitution answers 80 however wide the window is: with stdout captured,
# ncurses reads the window size off stderr instead, and that redirect throws
# the only usable fd away. It is why the rules here stopped short of the right
# edge. stty asks /dev/tty directly. Kept in step with base_functions.sh.
term_cols() {
    local cols="${COLUMNS:-}"
    if [[ ! "$cols" =~ ^[0-9]+$ ]] || (( cols <= 0 )); then
        cols="$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)"
    fi
    if [[ ! "$cols" =~ ^[0-9]+$ ]] || (( cols <= 0 )); then
        cols=80
    fi
    printf '%s' "$cols"
}

hr() {  # a full-width colored rule
    local ch="${1:-━}" cols line
    cols="${COLS:-$(term_cols)}"
    printf -v line '%*s' "$cols" ''
    printf '%s%s%s\n' "$C_RULE" "${line// /$ch}" "$C_RESET"
}

banner() {
    hr
    printf '   %s⛩ GO TIME ⛩%s   %spick a workspace — launch the session%s%s\n' \
        "$C_JADE$C_BOLD" "$C_RESET" "$C_META" "$C_RESET" "$CLR_EOL"
    hr
}

render_row() {  # render_row <index> <selected-index> <number-width>
    local i="$1" sel="$2" numw="$3" num name plain pad
    num="$(printf "%${numw}d" $(( i + 1 )))"
    name="${NAMES[$i]}"
    if (( i == sel )); then
        # Paint the bar with real spaces rather than stretching it with
        # CLR_EOL. ESC[K only carries the current background to the edge on a
        # terminal advertising `bce`; screen and tmux do not, and gotime can
        # be started from inside tmux — there the bar would stop at the name.
        # Both branches lead with four columns, " ❯  " or four spaces, so one
        # template measures either.
        printf -v plain '    %s   %s' "$num" "$name"
        pad=$(( ${COLS:-$(term_cols)} - ${#plain} ))
        (( pad < 0 )) && pad=0
        printf '%s%s%s ❯  %s   %s%*s%s\n' \
            "$SEL_BG" "$C_BOLD" "$C_JADE" "$num" "$name" "$pad" '' "$C_RESET"
    else
        # CLR_EOL is right here, and portable: erasing to the *default*
        # background is exactly what clearing the bar off this row needs.
        printf '    %s%s%s   %s%s%s%s\n' \
            "$C_META" "$num" "$C_RESET" "$C_FG" "$name" "$C_RESET" "$CLR_EOL"
    fi
}

footer() {  # footer <selected-index> <number-buffer>
    local sel="$1" numbuf="$2" tgt="${PATHS[$sel]}" pin=""
    # The pinned window is optional, so the window list it heads is built
    # rather than spelled out.
    [[ -n "$PIN_LABEL" ]] && pin="$PIN_LABEL · "
    # Shorten $HOME to ~ without relying on ${var/#.../~} — bash tilde-expands
    # the replacement string, so build it inside double quotes instead.
    case "$tgt" in
        "$HOME"/*) tgt="~/${tgt#"$HOME"/}" ;;
        "$HOME")   tgt="~" ;;
    esac
    printf '%s\n' "$CLR_EOL"
    hr
    printf ' %s↑/↓%s or %sj/k%s move   %s1-9%s jump   %s⏎%s start   %sq%s quit%s\n' \
        "$C_JADE" "$C_RESET" "$C_JADE" "$C_RESET" "$C_JADE" "$C_RESET" \
        "$C_JADE" "$C_RESET" "$C_JADE" "$C_RESET" "$CLR_EOL"
    # The selection name and the target path both change length as the
    # highlight moves, so this line has to erase its own tail.
    printf ' %swindows:%s %s%s%s%s · local     %s%s%s' \
        "$C_META" "$C_RESET" "$pin" "$C_BOLD$C_JADE" "${NAMES[$sel]}" "$C_RESET" \
        "$C_META" "$tgt" "$C_RESET"
    [[ -n "$numbuf" ]] && printf '   %s[%s]%s' "$C_VIOLET" "$numbuf" "$C_RESET"
    printf '%s\n' "$CLR_EOL"
}

draw() {  # draw <selected-index> <number-buffer>
    local sel="$1" numbuf="$2" i kind prev="" numw="${#COUNT}"
    # Measure once per frame. term_cols forks stty, and hr wants the width
    # three times per frame with the selected row wanting it once more —
    # measured at 5 calls per frame uncached against 1 with this. Re-read
    # every frame rather than once at startup, so a window resize is picked
    # up on the next keypress.
    COLS="$(term_cols)"
    # Home and overwrite in place; do NOT clear first. `tput clear` blanks the
    # screen and the ~40 writes that repaint it are separate, so the terminal
    # renders the empty frame — a visible flicker on every keypress. Each line
    # erases its own tail with CLR_EOL, and CLR_EOS at the end drops whatever
    # a taller previous frame left below this one.
    printf '%s' "$CUR_HOME"
    banner
    for (( i = 0; i < COUNT; i++ )); do
        kind="${KINDS[$i]}"
        if [[ "$kind" != "$prev" ]]; then
            printf '%s\n %s%s%s%s\n' "$CLR_EOL" \
                "$C_VIOLET$C_BOLD" "$kind" "$C_RESET" "$CLR_EOL"
            prev="$kind"
        fi
        render_row "$i" "$sel" "$numw"
    done
    footer "$sel" "$numbuf"
    printf '%s' "$CLR_EOS"
}

# --- input ------------------------------------------------------------------
# Decode one keypress into a symbolic KEY. Works on bash 3.2+ (no read -N, no
# fractional -t). Arrow keys arrive as ESC then "[A"/"OA" etc.; a lone Esc is
# distinguished by the 1-second read timing out.
read_key() {
    local k s
    KEY=""; KEYCH=""
    IFS= read -rsn1 k || { KEY="QUIT"; return; }
    if [[ -z "$k" ]]; then KEY="ENTER"; return; fi
    case "$k" in
        $'\r'|$'\n')   KEY="ENTER" ;;
        $'\x1b')
            IFS= read -rsn2 -t 1 s
            case "$s" in
                '[A'|'OA') KEY="UP" ;;
                '[B'|'OB') KEY="DOWN" ;;
                '[H'|'OH') KEY="HOME" ;;
                '[F'|'OF') KEY="END" ;;
                '')        KEY="QUIT" ;;   # bare Esc
                *)         KEY="OTHER" ;;
            esac ;;
        $'\x7f'|$'\x08') KEY="BACKSPACE" ;;
        [0-9])           KEY="DIGIT"; KEYCH="$k" ;;
        k|K)             KEY="UP" ;;
        j|J)             KEY="DOWN" ;;
        g)               KEY="HOME" ;;
        G)               KEY="END" ;;
        q|Q)             KEY="QUIT" ;;
        *)               KEY="OTHER" ;;
    esac
}

menu() {
    SELIDX=0
    local numbuf="" n cand
    tput smcup 2>/dev/null; tput civis 2>/dev/null; TUI_ACTIVE=1
    # The only clear in the session. The alternate screen is not guaranteed
    # blank on entry; every later frame overwrites in place instead.
    tput clear 2>/dev/null || printf '\033[H\033[J'
    draw "$SELIDX" "$numbuf"
    while true; do
        read_key
        case "$KEY" in
            ENTER) break ;;
            QUIT)  SELIDX=-1; break ;;
            UP)    numbuf=""; SELIDX=$(( (SELIDX - 1 + COUNT) % COUNT )) ;;
            DOWN)  numbuf=""; SELIDX=$(( (SELIDX + 1) % COUNT )) ;;
            HOME)  numbuf=""; SELIDX=0 ;;
            END)   numbuf=""; SELIDX=$(( COUNT - 1 )) ;;
            BACKSPACE)
                numbuf="${numbuf%?}"
                if [[ -n "$numbuf" ]]; then
                    n=$(( 10#$numbuf ))
                    (( n >= 1 && n <= COUNT )) && SELIDX=$(( n - 1 ))
                fi ;;
            DIGIT)
                cand="${numbuf}${KEYCH}"
                n=$(( 10#$cand ))
                if (( n >= 1 && n <= COUNT )); then
                    numbuf="$cand"; SELIDX=$(( n - 1 ))
                elif (( 10#$KEYCH >= 1 && 10#$KEYCH <= COUNT )); then
                    numbuf="$KEYCH"; SELIDX=$(( 10#$KEYCH - 1 ))
                else
                    numbuf=""
                fi ;;
            *) : ;;
        esac
        draw "$SELIDX" "$numbuf"
    done
    tput cnorm 2>/dev/null; tput rmcup 2>/dev/null; TUI_ACTIVE=""
}

# --- tmux launch ------------------------------------------------------------
attach_session() {
    local s="$1"
    if [[ -n "${GOTIME_NO_ATTACH:-}" ]]; then
        printf '%s▌ PASS   session "%s" ready%s (not attaching).\n' "$C_JADE" "$s" "$C_RESET"
        return 0
    fi
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$s"
    else
        tmux attach-session -t "=$s"
    fi
}

launch() {  # launch <slug> <target-dir>
    local slug="$1" target="$2" s="$GOTIME_SESSION"
    local pin_dir="$PIN_PATH" pin_name="$PIN_LABEL" w1 wsel w ans
    local first_name first_dir
    local -a wins=()

    # A configured pin that is not there is a config error, not a reason to
    # open a window somewhere arbitrary: say so and build the session without.
    if [[ -n "$pin_dir" && ! -d "$pin_dir" ]]; then
        printf '%s▌ WARN   pinned directory %s not found; opening without it.%s\n' \
            "$C_SAFFRON" "$pin_dir" "$C_RESET"
        pin_dir="" pin_name=""
    fi

    command -v "${GOTIME_CMD%% *}" >/dev/null 2>&1 || printf '%s▌ WARN   `%s` is not on PATH; those windows will show a "command not found".%s\n' \
        "$C_SAFFRON" "${GOTIME_CMD%% *}" "$C_RESET"

    if tmux has-session -t "=$s" 2>/dev/null; then
        if [[ -n "${GOTIME_NO_ATTACH:-}" ]]; then
            tmux kill-session -t "=$s"
        else
            printf '%s▌ WARN   A tmux session named "%s" already exists.%s\n' "$C_SAFFRON" "$s" "$C_RESET"
            printf '  [a] attach to it    [r] recreate it fresh    [c] cancel   ? '
            IFS= read -r ans
            case "$ans" in
                a|A) attach_session "$s"; return $? ;;
                r|R) tmux kill-session -t "=$s" ;;
                *)   printf 'gotime: cancelled.\n'; return 0 ;;
            esac
        fi
    fi

    # Build the windows, capturing each window id so later commands are immune
    # to base-index settings and name collisions. `new-session` has to make the
    # first one, and which window that is depends on whether a pin exists.
    if [[ -n "$pin_dir" ]]; then first_name="$pin_name"; first_dir="$pin_dir"
    else                         first_name="$slug";     first_dir="$target"
    fi

    w1="$(tmux new-session -d -s "$s" -n "$first_name" -c "$first_dir" -P -F '#{window_id}')" || {
        printf '%sgotime: failed to create tmux session.%s\n' "$C_STOP" "$C_RESET" >&2; return 1; }
    wins=("$w1")

    if [[ -n "$pin_dir" ]]; then
        wsel="$(tmux new-window -t "=$s:" -n "$slug" -c "$target" -P -F '#{window_id}')"
        wins+=("$wsel")
    else
        wsel="$w1"   # no pin: the first window already is the selection
    fi
    wins+=("$(tmux new-window -t "=$s:" -n local -c "$HOME" -P -F '#{window_id}')")

    # Keep the window names we chose (claude/node would otherwise rename them).
    for w in "${wins[@]}"; do
        tmux set-window-option -t "$w" automatic-rename off 2>/dev/null
        tmux set-window-option -t "$w" allow-rename off 2>/dev/null
    done

    tmux send-keys -t "$w1" "$GOTIME_CMD" Enter
    [[ "$wsel" != "$w1" ]] && tmux send-keys -t "$wsel" "$GOTIME_CMD" Enter
    tmux select-window -t "$w1"   # land on the pin if there is one, else the selection

    attach_session "$s"
}

# --- top level --------------------------------------------------------------
usage() {
    cat <<'EOF'
gotime — pick a workspace and launch a tmux work session.

  gotime            show the menu, then launch
  gotime <slug>     skip the menu and launch straight for <slug>
  gotime --list     show the resolved config and the workspaces gotime sees
  gotime --init     write a starter config file
  gotime -h|--help  show this help

The session gets a window for your selection (running GOTIME_CMD), a "local"
window with a plain shell in ~, and — if GOTIME_PIN is set — a pinned window
ahead of both.

Config lives in ~/.config/gotime/config (or ~/.gotimerc) and is sourced as
bash. `gotime --init` writes a commented starter; the keys are GOTIME_ROOTS,
GOTIME_PIN, GOTIME_SESSION, and GOTIME_CMD, each also readable from the
environment, which wins over the file.
EOF
}

list_items() {
    local i w=0
    printf 'config:  %s\n' "${GOTIME_CONFIG_LOADED:-none — using built-in defaults}"
    printf 'roots:   %s\n' "$(roots_oneline)"
    if [[ -n "$PIN_PATH" ]]; then
        printf 'pinned:  %s (%s)\n' "$PIN_LABEL" "$PIN_PATH"
    else
        printf 'pinned:  none\n'
    fi
    printf 'command: %s\n\n' "$GOTIME_CMD"

    if (( COUNT == 0 )); then
        printf 'No workspaces found. Run `gotime --init`, then edit GOTIME_ROOTS.\n'
        return 0
    fi
    # Section labels are config-supplied now, so the column is measured rather
    # than assumed to fit "project".
    for (( i = 0; i < COUNT; i++ )); do
        (( ${#KINDS[$i]} > w )) && w="${#KINDS[$i]}"
    done
    printf 'Workspaces gotime can see:\n'
    for (( i = 0; i < COUNT; i++ )); do
        printf '  %2d  %-*s  %s\n' "$(( i + 1 ))" "$w" "${KINDS[$i]}" "${NAMES[$i]}"
    done
}

init_config() {
    local f d roots="" r
    f="${GOTIME_CONFIG:-$(xdg_config)}"

    if [[ -e "$f" ]]; then
        printf 'gotime: %s already exists; not overwriting it.\n' "$f" >&2
        return 1
    fi
    # config_path prefers the XDG file, so writing one while ~/.gotimerc exists
    # silently retires the older file. Say so rather than let it puzzle later.
    if [[ "$f" != "$HOME/.gotimerc" && -f "$HOME/.gotimerc" ]]; then
        printf '%s▌ WARN   ~/.gotimerc exists; the new file takes precedence over it.%s\n' \
            "$C_SAFFRON" "$C_RESET"
    fi

    d="${f%/*}"
    [[ "$d" == "$f" ]] || mkdir -p "$d" || {
        printf 'gotime: could not create %s\n' "$d" >&2; return 1; }

    # Seed GOTIME_ROOTS with the trees this machine actually has, written as
    # $HOME/... rather than expanded, so the file stays portable between boxes.
    for r in $GOTIME_DEFAULT_ROOTS; do
        [[ -d "$HOME/$r" ]] && roots="${roots}${roots:+ }\$HOME/$r"
    done
    [[ -n "$roots" ]] || roots='$HOME/projects'

    cat > "$f" <<EOF || { printf 'gotime: could not write %s\n' "$f" >&2; return 1; }
# gotime configuration. Sourced as bash, so \$HOME and command substitution
# work here. Every key below is also an environment variable, and the
# environment wins over this file.

# Trees to scan for workspaces. Entries are "[LABEL:]path", separated by
# whitespace or newlines; without a LABEL the directory's own name becomes the
# menu heading. Paths must not contain spaces.
GOTIME_ROOTS="$roots"

# An always-present first window, opened here and running GOTIME_CMD — a notes
# vault, a dotfiles repo, wherever you want a second context every session.
# Leave empty for no pinned window.
GOTIME_PIN=""

# tmux session name.
GOTIME_SESSION="gotime"

# Command started in the pinned window and the selected window. The "local"
# window never runs it.
GOTIME_CMD="claude"
EOF

    printf '%s▌ PASS   wrote %s%s\n' "$C_JADE" "$f" "$C_RESET"
    printf '  Edit it, then run `gotime --list` to check what it sees.\n'
}

cleanup() {
    if [[ -n "$TUI_ACTIVE" ]]; then
        tput cnorm 2>/dev/null; tput rmcup 2>/dev/null; TUI_ACTIVE=""
    fi
}
trap cleanup EXIT INT TERM

main() {
    local direct="" idx slug target
    case "${1:-}" in
        -h|--help) usage; exit 0 ;;
        # --init deliberately skips load_config: a config too broken to source
        # is exactly when you want to be able to write a fresh one.
        --init)    init_config; exit $? ;;
        --list)    load_config; discover; list_items; exit 0 ;;
        -*)        printf 'gotime: unknown option "%s"\n\n' "$1" >&2; usage >&2; exit 2 ;;
        '')        : ;;
        *)         direct="$1" ;;
    esac

    load_config

    if ! command -v tmux >/dev/null 2>&1; then
        printf 'gotime: tmux is not installed.\n' >&2; exit 1
    fi

    if [[ -z "${GOTIME_ROOTS//[[:space:]]/}" ]]; then
        printf 'gotime: no work trees configured, and none of the usual ones exist.\n' >&2
        printf 'gotime: run `gotime --init`, then set GOTIME_ROOTS in %s\n' "$(config_path)" >&2
        exit 1
    fi

    discover
    (( COUNT > 0 )) || {
        printf 'gotime: no workspaces found under: %s\n' "$(roots_oneline)" >&2
        printf 'gotime: check GOTIME_ROOTS in %s\n' "${GOTIME_CONFIG_LOADED:-$(config_path)}" >&2
        exit 1
    }

    if [[ -n "$direct" ]]; then
        if ! idx="$(find_slug "$direct")"; then
            printf 'gotime: no course or project named "%s".\n\n' "$direct" >&2
            list_items >&2
            exit 1
        fi
    else
        if [[ ! -t 0 || ! -t 1 ]]; then
            printf 'gotime: not an interactive terminal; pass a slug instead (e.g. gotime ai).\n' >&2
            exit 1
        fi
        menu
        idx="$SELIDX"
        if (( idx < 0 )); then printf 'gotime: cancelled.\n'; exit 0; fi
    fi

    slug="${NAMES[$idx]}"
    target="${PATHS[$idx]}"
    [[ -d "$target" ]] || { printf 'gotime: target directory missing: %s\n' "$target" >&2; exit 1; }

    launch "$slug" "$target"
}

main "$@"
